     OpenAI-family models (``openai/``, ``azure/``, ``aws/`` prefixes) go through
     ``ChatOpenAI``, which supports structured output. Everything else uses
     ``ChatNVIDIA``.
+
+    LOCAL PATCH: ``LLM_CLIENT=openai`` routes every model through ``ChatOpenAI``.
+    The hosted build.nvidia.com endpoint now rejects ChatNVIDIA's
+    ``nvext.guided_json`` (400 "unknown field guided_json") but accepts the
+    standard OpenAI ``response_format`` json_schema. Reasoning Nemotron models
+    can also spend the whole ``max_tokens`` budget thinking (finish=length,
+    no answer), so thinking is capped at half the budget via
+    ``nvext.max_thinking_tokens``.
     """
-    if model.startswith(("openai/", "azure/", "aws/")):
+    is_openai_family = model.startswith(("openai/", "azure/", "aws/"))
+    if os.environ.get("LLM_CLIENT", "").lower() == "openai" or is_openai_family:
         from langchain_openai import ChatOpenAI
 
+        extra: dict = {}
+        # Claude and GPT-5 / o-series reject an explicit temperature (400).
+        bare = model.lower().rsplit("/", 1)[-1]
+        rejects_temperature = (
+            "claude" in model.lower()
+            or bare.startswith(("gpt-5", "o1", "o3", "o4"))
+        )
+        if not is_openai_family and not rejects_temperature:
+            extra["temperature"] = temperature
+        if "nvidia.com" in base_url:
+            # nvext is NVIDIA-only; other OpenAI-compatible endpoints may reject it.
+            extra["extra_body"] = {
+                "nvext": {"max_thinking_tokens": max(256, max_tokens // 2)}
+            }
         return ChatOpenAI(
+            **extra,
             model=model,
             api_key=api_key,
             base_url=base_url,
